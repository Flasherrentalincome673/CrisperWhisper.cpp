+int whisper_decode_with_state_and_cross_attention(
+        struct whisper_context * ctx,
+          struct whisper_state * state,
+           const whisper_token * tokens,
+                           int   n_tokens,
+                           int   n_past,
+                           int   n_threads) {
+    if (!ctx->params.dtw_token_timestamps) {
+        WHISPER_LOG_ERROR("%s: context was not initialized for alignment-head capture\n", __func__);
+        return 1;
+    }
+
+    whisper_batch_prep_legacy(state->batch, tokens, n_tokens, n_past, 0);
+    whisper_kv_cache_seq_rm(state->kv_self, 0, n_past, -1);
+
+    if (!whisper_decode_internal(*ctx, *state, state->batch, n_threads, true, nullptr, nullptr)) {
+        WHISPER_LOG_ERROR("%s: failed to eval\n", __func__);
+        return 1;
+    }
+
+    return 0;
+}
+
+int whisper_cross_attention_n_tokens_from_state(const struct whisper_state * state) {
+    return state != nullptr && state->aheads_cross_QKs != nullptr
+        ? (int) state->aheads_cross_QKs->ne[0]
+        : 0;
+}
+
+int whisper_cross_attention_n_frames_from_state(const struct whisper_state * state) {
+    return state != nullptr && state->aheads_cross_QKs != nullptr
+        ? (int) state->aheads_cross_QKs->ne[1]
+        : 0;
+}
+
+int whisper_cross_attention_n_heads_from_state(const struct whisper_state * state) {
+    return state != nullptr && state->aheads_cross_QKs != nullptr
+        ? (int) state->aheads_cross_QKs->ne[2]
+        : 0;
+}
+
+size_t whisper_cross_attention_copy_from_state(
+        const struct whisper_state * state,
+                          float * destination,
+                         size_t   destination_count) {
+    if (state == nullptr || state->aheads_cross_QKs == nullptr || destination == nullptr) {
+        return 0;
+    }
+    const size_t count = (size_t) ggml_nelements(state->aheads_cross_QKs);
+    if (destination_count < count) {
+        return 0;
+    }
+    ggml_backend_tensor_get(
+        state->aheads_cross_QKs, destination, 0, count * sizeof(float)
+    );
+    return count;
+}
+
+int whisper_mel_n_frames_from_state(const struct whisper_state * state) {
+    return state != nullptr ? state->mel.n_len : 0;
+}
+
+int whisper_mel_n_mels_from_state(const struct whisper_state * state) {
+    return state != nullptr ? state->mel.n_mel : 0;
+}
+
+size_t whisper_mel_copy_from_state(
+        const struct whisper_state * state,
+                          float * destination,
+                         size_t   destination_count) {
+    if (state == nullptr || destination == nullptr) {
+        return 0;
+    }
+    const size_t count = state->mel.data.size();
+    if (destination_count < count) {
+        return 0;
+    }
+    memcpy(destination, state->mel.data.data(), count * sizeof(float));
+    return count;
+}
